# ==============================================================================
# JO4 DEV - HIGH PERFORMANCE GO FIBER PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (production / development)
ENV=production

# Server Port
PORT=5000

# Security: 64-Character Random Secret Key for Session Authentication & CSRF
# Generate with: openssl rand -hex 32
SECRET_KEY=9a7c3f8e2b1d4065a8e7d2c19b4e5f03a6b8d9c2e1f40758a3b6c9d2e5f80147

# Database Connection (SQLite in WAL mode or PostgreSQL)
# Docker volume path: /app/data/jo4dev.db
DATABASE_URL=/app/data/jo4dev.db

# Initial Admin Credentials (Bcrypt hashed automatically on first boot)
# IMPORTANT: Use a strong, unique password for production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow_JO4Secure2026!

# Mailer Configuration (Brevo / SMTP)
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_login@domain.com
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_DEFAULT_SENDER=info@jo4.co.za

# Google Calendar Integration (Optional)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_SERVICE_ACCOUNT_FILE=/app/data/google-service-account.json
